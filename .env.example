# ========================================================
# Ticketing System Environment Configuration
# ========================================================

# Host prefix when served behind APIGW (e.g., /ticketing or empty /)
HOST_PREFIX=/ticketing

# Servlet context path for Spring Boot (e.g., /ticketing or empty for root)
CONTEXT_PATH=/ticketing

# Port on which the Spring Boot application runs inside container
PORT=8080

# External host port mapped to container PORT
HOST_PORT=8086

# PostgreSQL Configuration (remote host)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=ticketing_db
DB_USER=admin
DB_PASSWORD=admin
JPA_DDL_AUTO=update

# Keycloak JWT Relayed Header
JWT_HEADER=Authorization
JWT_PREFIX=Bearer 

# Attachment Configurable Limits
MAX_ATTACHMENT_COUNT=10
MAX_ATTACHMENT_SIZE_MB=20
ATTACHMENT_STORAGE_DIR=./data/attachments
AVATAR_STORAGE_DIR=./data/avatars
