# ========================================================
# Ticketing System Environment Configuration
# ========================================================

# Customized Base Image (build arg for Dockerfile)
BASE_IMAGE=customized-eclipse-temurin:21-jdk

# Centralized Config Manager Integration
CONFIG_IMPORT_ENABLED=true
CONFIG_EXPORT_ENABLED=false
CONFIG_MANAGER_URL=https://config-manager:8443
APPLICATION_NAME=ticketing-app
CONFIG_PARAMS=pg
CONFIG_CERTS_PATH=/config

# Host prefix when served behind APIGW (e.g., /ticketing or empty /)
HOST_PREFIX=/ticketing

# Servlet context path for Spring Boot (e.g., /ticketing or empty for root)
CONTEXT_PATH=/ticketing

# Port on which the Spring Boot application runs inside container
PORT=8080

# External host port mapped to container PORT
HOST_PORT=8086

# ========================================================
# Configurations Imported via Config Manager
#
# The following variables are managed centrally and fetched
# dynamically at container startup from config-manager:
#
# Under application name ('ticketing-app'):
#   - JWT_HEADER
#   - JWT_PREFIX
#   - MAX_ATTACHMENT_COUNT
#   - MAX_ATTACHMENT_SIZE_MB
#   - MAX_AVATAR_SIZE_MB
#   - ATTACHMENT_STORAGE_DIR
#   - AVATAR_STORAGE_DIR
#
# Under infrastructure set ('pg'):
#   - DB_HOST
#   - DB_PORT
#   - DB_NAME
#   - DB_USER
#   - DB_PASSWORD
#   - JPA_DDL_AUTO
# ========================================================
